{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:shared && npm run build:server && npm run build:client",
  "outputDirectory": "client/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
