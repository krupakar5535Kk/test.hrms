# ==============================================================================
# BACKEND SERVER ENVIRONMENT CONFIGURATION (.env.example)
# Copy to server/.env in local development or staging. Never commit real secrets!
# Connected Project Reference: klbgtuetbeoowciotjed (HRMS Payroll 5535, ap-south-1)
# ==============================================================================

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# Local Supabase (docker): http://127.0.0.1:54321
# Hosted HRMS Payroll 5535: https://klbgtuetbeoowciotjed.supabase.co
SUPABASE_URL=https://klbgtuetbeoowciotjed.supabase.co
SUPABASE_ANON_KEY=<paste-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<paste-supabase-service-role-key-for-provisioning-and-private-storage>

# JWT Secret & Verification
JWT_SECRET=<paste-supabase-jwt-secret>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

SUPABASE_JWT_ISSUER=https://klbgtuetbeoowciotjed.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://klbgtuetbeoowciotjed.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=<paste-supabase-jwt-secret>

# PostgreSQL Connection Pool Configuration (strictly hrms_app_user, never postgres)
# Local dev: DB_HOST=127.0.0.1, DB_PORT=54322, DB_SSL=false
# Hosted Supabase Transaction/Session Pooler (ap-south-1):
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com, DB_PORT=5432 or 6543, DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=54322
DB_NAME=postgres
DB_USER=hrms_app_user
DB_PASSWORD=<set-hrms_app_user-password>
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# ==============================================================================
# Authentication HMAC Keys (256-bit / 64 lowercase hex chars each)
# ==============================================================================
SESSION_TOKEN_HMAC_KEY=<generate: node -e "require('crypto').randomBytes(32).toString('hex')">
OTP_HMAC_PEPPER=<generate: node -e "require('crypto').randomBytes(32).toString('hex')">
RATE_LIMIT_HMAC_KEY=<generate: node -e "require('crypto').randomBytes(32).toString('hex')">
TX_CONTEXT_HMAC_KEY=<generate: node -e "require('crypto').randomBytes(32).toString('hex')">
TX_CONTEXT_HMAC_KEY_ID=<generate: node -e "require('crypto').randomUUID()">
CSRF_HMAC_SECRET=<generate: node -e "require('crypto').randomBytes(32).toString('hex')">

# ==============================================================================
# Face Verification Provider Adapter (unconfigured by default — never faked)
# ==============================================================================
# Leave FACE_PROVIDER unset to auto-select 'compreface' when COMPREFACE_BASE_URL + COMPREFACE_API_KEY are set.
FACE_PROVIDER=unconfigured
FACE_PROVIDER_URL=
FACE_PROVIDER_API_KEY=

# CompreFace 1.2.0 Recognition Service (server-only — never expose COMPREFACE_API_KEY to frontend/logs)
# Host development mode:      http://localhost:8000
# Docker container DNS mode:  http://compreface-ui:80 (or http://compreface-api:8080) via hrms-biometrics-net
COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_API_KEY=
COMPREFACE_SIMILARITY_THRESHOLD=0.85
COMPREFACE_DET_PROB_THRESHOLD=0.8
COMPREFACE_TIMEOUT_MS=8000
COMPREFACE_MAX_RETRIES=1

# Self-Hosted Liveness & Anti-Spoofing Sidecar (server-only — never expose LIVENESS_API_KEY to frontend/logs)
# Values for LIVENESS_PROVIDER: none | hybrid-onnx | http
# Host development mode:      http://127.0.0.1:8100
# Docker container DNS mode:  http://hrms-liveness:8100 via hrms-biometrics-net
LIVENESS_PROVIDER=none
LIVENESS_BASE_URL=http://127.0.0.1:8100
LIVENESS_API_KEY=<generate-strong-shared-secret-matching-hrms-liveness>
LIVENESS_PASSIVE_THRESHOLD=0.62
LIVENESS_CHALLENGE_TTL_MS=90000
LIVENESS_TIMEOUT_MS=8000
LIVENESS_MAX_RETRIES=1

# ==============================================================================
# CORS, Cookies & Proxy Security
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
TRUST_PROXY=loopback
RATE_LIMIT_BACKEND=memory
